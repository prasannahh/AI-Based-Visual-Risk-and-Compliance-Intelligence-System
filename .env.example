# =============================================================================
# Digital Twin AI - environment variables example
# =============================================================================
# Copy this file to `.env` (or set the same variables in your shell / Streamlit
# secrets) and fill in your own values. NEVER commit your real secrets.
#
# The app reads environment variables directly (os.getenv), so no external
# dotenv loader is required, but you may export these in your shell. Values set
# in `.streamlit/secrets.toml` take precedence over environment variables.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL connection (fallback when not provided in .streamlit/secrets.toml)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_twin
DB_USER=postgres
DB_PASSWORD=change_me

# -----------------------------------------------------------------------------
# Session / JWT
# -----------------------------------------------------------------------------
# Secret used to sign login tokens. Use a long, random value in production.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_HOURS=24

# -----------------------------------------------------------------------------
# Conversational AI - LLM provider
# -----------------------------------------------------------------------------
# Choose ONE of: gemini | rule_based
#   - "gemini"     (primary) uses Google's Gemini API (needs google-genai)
#   - "rule_based" (default) uses the built-in deterministic grounded assistant.
#                  No API key required - the app works fully offline.
# When LLM_PROVIDER=gemini and the Gemini API is unavailable (missing key,
# API error, network failure, etc.), the app automatically falls back to
# the built-in rule-based assistant.
LLM_PROVIDER=gemini

# --- Gemini (used when LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- Shared LLM tuning (optional) ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=60
LLM_RATE_LIMIT_RETRIES=2
