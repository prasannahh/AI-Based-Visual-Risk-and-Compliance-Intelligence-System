# Copy this file to .streamlit/secrets.toml and fill in your PostgreSQL details.
# The app will also fall back to environment variables (DB_HOST, DB_PORT,
# DB_NAME, DB_USER, DB_PASSWORD) if this file is not present.

[postgres]
host = "localhost"
port = 5432
dbname = "digital_twin"
user = "postgres"
password = "your_password"
